<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников" Height="600" Width="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: список врагов -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Список противников" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox Name="EnemiesListBox" Height="500"
                     SelectionChanged="EnemiesListBox_SelectionChanged"/>
        </StackPanel>

        <!-- ЦЕНТР: поля ввода и кнопки -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Параметры противника" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Имя противника:"/>
            <TextBox Name="EnemyNameBox" Margin="0,0,0,5"/>

            <TextBlock Text="Имя иконки:"/>
            <TextBox Name="IconNameBox" Margin="0,0,0,5"/>

            <TextBlock Text="Базовое здоровье:"/>
            <TextBox Name="BaseLifeBox" Margin="0,0,0,5"/>

            <TextBlock Text="Базовое золото:"/>
            <TextBox Name="BaseGoldBox" Margin="0,0,0,5"/>

            <TextBlock Text="Модификатор здоровья:"/>
            <TextBox Name="LifeModifierBox" Margin="0,0,0,5"/>

            <TextBlock Text="Модификатор золота:"/>
            <TextBox Name="GoldModifierBox" Margin="0,0,0,5"/>

            <TextBlock Text="Шанс появления:"/>
            <TextBox Name="SpawnChanceBox" Margin="0,0,0,15"/>

            <WrapPanel>
                <Button Content="Добавить" Width="110" Height="35" Margin="0,0,5,5"
                        Click="AddButton_Click"/>
                <Button Content="Удалить" Width="110" Height="35" Margin="0,0,5,5"
                        Click="RemoveButton_Click"/>
                <Button Content="Сохранить" Width="110" Height="35" Margin="0,0,5,5"
                        Click="SaveButton_Click"/>
                <Button Content="Загрузить" Width="110" Height="35" Margin="0,0,5,5"
                        Click="LoadButton_Click"/>
                <Button Content="Загрузить иконки" Width="150" Height="35" Margin="0,0,5,5"
                        Click="LoadIconsButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <!--ПРАВАЯ КОЛОНКА: иконки -->
        <StackPanel Grid.Column="2" Margin="10">
            <TextBlock Text="Иконки" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox Name="IconsListBox" Height="450"
                     SelectionChanged="IconsListBox_SelectionChanged"/>

            <TextBlock Text="Главная иконка:" Margin="0,10,0,5"/>
            <Image Name="MainEnemyIcon" Height="80" Width="80"
                   HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>